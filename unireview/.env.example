# Copy this file to .env (same folder), fill in the real value.
# .env is gitignored — it will NEVER be committed.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# reCAPTCHA v3 SITE key (public, safe to expose to the browser — this is
# NOT the secret key; the secret key lives only in the backend's
# application-local.yml, never here).
VITE_RECAPTCHA_SITE_KEY=
