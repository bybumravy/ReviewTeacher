# Copy to .env (same folder), fill in real values, then: docker-compose up -d --build
# .env is gitignored — never committed. Used by the root docker-compose.yml
# to configure the postgres + backend + frontend containers together.

DB_PASSWORD=choose_a_real_postgres_password
JWT_SECRET=replace_with_a_long_random_base64_string
PERSPECTIVE_API_KEY=replace_with_real_perspective_api_key
RECAPTCHA_SECRET_KEY=replace_with_real_recaptcha_secret_key
VITE_RECAPTCHA_SITE_KEY=replace_with_real_recaptcha_site_key
